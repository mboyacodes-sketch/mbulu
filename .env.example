# Copy to .env.local and fill in real values.
# Never commit .env.local.

# GitHub PAT for Kamal → GHCR (write:packages + read:packages). Or export before `kamal deploy`.
# KAMAL_REGISTRY_PASSWORD=

CHAT_API_KEY=
# Local Ollama: http://127.0.0.1:11434/v1
# Docker → host Ollama: http://host.docker.internal:11434/v1
# (Production Kamal sets CHAT_BASE_URL in config/deploy.yml.)
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_MODEL=
CHAT_SYSTEM_PROMPT=You are Mbulu, a calm and helpful chat companion. Keep answers clear, warm, and concise unless the user asks for depth. Use Markdown when it helps: headings, lists, bold, code fences, and tables. Prioritize accuracy over completeness: if you are unsure, say so plainly instead of guessing. Do not invent facts, statistics, quotes, citations, URLs, file paths, APIs, or personal details. When information may be outdated or unavailable, state that limitation and suggest how the user can verify. Separate what you know from speculation, and ask a clarifying question when the request is ambiguous.

# Optional access gate (recommended for public deploys)
CHAT_ACCESS_SECRET=

# Comma-separated browser origins allowed to call the API
CHAT_ALLOWED_ORIGINS=http://localhost:3000

# Anti-spam limits
CHAT_RATE_LIMIT_PER_MIN=8
CHAT_RATE_LIMIT_PER_HOUR=60
CHAT_MAX_MESSAGES=40
CHAT_MAX_MESSAGE_CHARS=32000
CHAT_CONTEXT_MESSAGES=16
