# Copy to .env.local and fill in real values.
# Never commit .env.local.

CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_SYSTEM_PROMPT=You are Mbulu, a calm and helpful chat companion. Keep answers clear, warm, and concise unless the user asks for depth. Use Markdown when it helps: headings, lists, bold, code fences, and tables.

# Optional access gate (recommended for public deploys)
CHAT_ACCESS_SECRET=

# Comma-separated browser origins allowed to call the API
CHAT_ALLOWED_ORIGINS=http://localhost:3000

# Anti-spam limits
CHAT_RATE_LIMIT_PER_MIN=8
CHAT_RATE_LIMIT_PER_HOUR=60
CHAT_MAX_MESSAGES=40
CHAT_MAX_MESSAGE_CHARS=32000
CHAT_CONTEXT_MESSAGES=16
