# Copy to `.kamal/secrets` (gitignored). Kamal parses this as dotenv — not bash.

KAMAL_REGISTRY_PASSWORD=$(grep ^KAMAL_REGISTRY_PASSWORD= .env.local 2>/dev/null | head -1 | cut -d= -f2-)

CHAT_API_KEY=$(grep ^CHAT_API_KEY= .env.local 2>/dev/null | head -1 | cut -d= -f2-)
CHAT_BASE_URL=$(grep ^CHAT_BASE_URL= .env.local 2>/dev/null | head -1 | cut -d= -f2-)
CHAT_MODEL=$(grep ^CHAT_MODEL= .env.local 2>/dev/null | head -1 | cut -d= -f2-)
CHAT_SYSTEM_PROMPT=$(grep ^CHAT_SYSTEM_PROMPT= .env.local 2>/dev/null | head -1 | cut -d= -f2-)
CHAT_ACCESS_SECRET=$(grep ^CHAT_ACCESS_SECRET= .env.local 2>/dev/null | head -1 | cut -d= -f2-)
